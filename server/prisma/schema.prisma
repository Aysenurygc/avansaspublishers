generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
  WRITER
  EDITOR
}

enum ProjectStatus {
  PENDING
  ACTIVE
  REVIEW
  REVISION
  COMPLETED
  PAUSED
}

enum Package {
  ESSENTIALS
  PROFESSIONAL
  PREMIER
  CUSTOM
}

enum ConsultationStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String
  role          Role      @default(CLIENT)
  avatar        String?
  phone         String?
  bio           String?
  isVerified    Boolean   @default(false)
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedProjects       Project[]       @relation("ProjectClient")
  teamMemberships     ProjectMember[]
  sentMessages        Message[]
  uploadedFiles       ProjectFile[]
  assignedConsults    Consultation[]
  blogPosts           BlogPost[]

  @@index([email])
}

model Project {
  id        String        @id @default(uuid())
  clientId  String
  client    User          @relation("ProjectClient", fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  service   String
  genre     String?
  wordCount Int?
  status    ProjectStatus @default(PENDING)
  progress  Int           @default(0)
  startDate DateTime?
  dueDate   DateTime?
  package   Package?
  price     Float?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  team       ProjectMember[]
  milestones Milestone[]
  messages   Message[]
  files      ProjectFile[]

  @@index([clientId])
  @@index([status])
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
}

model Message {
  id        String   @id @default(uuid())
  projectId String
  senderId  String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  files     String[] @default([])
  createdAt DateTime @default(now())

  @@index([projectId])
}

model ProjectFile {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  url          String
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime @default(now())

  @@index([projectId])
}

model Consultation {
  id           String             @id @default(uuid())
  name         String
  email        String
  phone        String?
  service      String?
  genre        String?
  budget       String?
  message      String?
  status       ConsultationStatus @default(PENDING)
  scheduledAt  DateTime?
  assignedToId String?
  assignedTo   User?              @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
  @@index([email])
}

enum LeadStatus {
  NEW
  CONTACTED
  BOOKED
  WON
  LOST
  JUNK
}

/// Someone who asked us for something: a tool result in writing, a call back,
/// a consultation. One row per person, with `LeadEvent` holding the timeline.
///
/// `consent` records an explicit marketing opt-in rather than inferring one
/// from the submission, because the house also sells into the UK, Canada,
/// Australia and New Zealand, where inferred consent is not sufficient.
///
/// `email` and `phone` are both optional and the intake requires at least one
/// of them: a phone-first form has no address to store, and a tool that only
/// emails a result has no number.
///
/// No IP address is stored. Abuse is handled by the rate limiter in front of
/// the route, which needs no record kept, so keeping one would mean holding
/// personal data this system never reads.
model Lead {
  id String @id @default(uuid())

  // Who they are
  name    String?
  email   String?
  /// Country code and number already joined, so it can be dialled as stored.
  phone   String?
  /// Kept separately so HQ can show the dial code it was given.
  phoneCc String?

  // What they asked for
  source   String
  /// Decides the score and how HQ reads the row. See lib/leads/scoring.js.
  formType String
  message  String?
  result   Json?
  segment  String?

  // How hot
  score Int     @default(50)
  hot   Boolean @default(false)

  consent Boolean @default(false)

  // First touch, stamped once on the first lead and never overwritten after.
  landingPath String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  visitorId   String?

  // Handling
  status      LeadStatus @default(NEW)
  outcome     String?
  contactedAt DateTime?
  followUpAt  DateTime?
  assignedTo  String?

  userAgent String?
  createdAt DateTime @default(now())
  /// Carries a database default as well, so the column can be added to a
  /// table that already holds rows.
  updatedAt DateTime @default(now()) @updatedAt

  events LeadEvent[]

  @@index([source])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@index([formType])
  @@index([status, hot, createdAt])
}

/// Everything that has happened to a lead, so whoever picks up the phone can
/// see what was already said rather than starting the conversation again.
model LeadEvent {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// created | repeat | alert_sent | alert_skipped | status | note | assigned
  kind      String
  detail    String?
  /// A user id, or "system" when the pipeline wrote it.
  actor     String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  category    String?
  tags        String[]  @default([])
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  coverImage  String?
  readTime    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([published, publishedAt])
}
