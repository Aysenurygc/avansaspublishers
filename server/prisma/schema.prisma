generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
  WRITER
  EDITOR
}

enum ProjectStatus {
  PENDING
  ACTIVE
  REVIEW
  REVISION
  COMPLETED
  PAUSED
}

enum Package {
  ESSENTIALS
  PROFESSIONAL
  PREMIER
  CUSTOM
}

enum ConsultationStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String
  role          Role      @default(CLIENT)
  avatar        String?
  phone         String?
  bio           String?
  isVerified    Boolean   @default(false)
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedProjects       Project[]       @relation("ProjectClient")
  teamMemberships     ProjectMember[]
  sentMessages        Message[]
  uploadedFiles       ProjectFile[]
  assignedConsults    Consultation[]
  blogPosts           BlogPost[]

  @@index([email])
}

model Project {
  id        String        @id @default(uuid())
  clientId  String
  client    User          @relation("ProjectClient", fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  service   String
  genre     String?
  wordCount Int?
  status    ProjectStatus @default(PENDING)
  progress  Int           @default(0)
  startDate DateTime?
  dueDate   DateTime?
  package   Package?
  price     Float?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  team       ProjectMember[]
  milestones Milestone[]
  messages   Message[]
  files      ProjectFile[]

  @@index([clientId])
  @@index([status])
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
}

model Message {
  id        String   @id @default(uuid())
  projectId String
  senderId  String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  files     String[] @default([])
  createdAt DateTime @default(now())

  @@index([projectId])
}

model ProjectFile {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  url          String
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime @default(now())

  @@index([projectId])
}

model Consultation {
  id           String             @id @default(uuid())
  name         String
  email        String
  phone        String?
  service      String?
  genre        String?
  budget       String?
  message      String?
  status       ConsultationStatus @default(PENDING)
  scheduledAt  DateTime?
  assignedToId String?
  assignedTo   User?              @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
  @@index([email])
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  category    String?
  tags        String[]  @default([])
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  coverImage  String?
  readTime    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([published, publishedAt])
}
